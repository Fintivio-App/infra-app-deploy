###############################################################################
# Fintivio single-VM demo — environment file
# Copy to `.env` and fill in secrets before running docker compose.
#   cp .env.example .env && edit .env
#
# This one file feeds: docker-compose.yml, nginx (via envsubst in scripts),
# Keycloak, Postgres, and every backend service.
###############################################################################

# ─── Public domain (demo) ────────────────────────────────────────────────────
# Host app lives at the bare domain; the rest are sub-domains of it.
#   fintivio.rosfin.tech            -> main-ui (Module Federation host)
#   remotes.fintivio.rosfin.tech    -> the 12 micro-frontends
#   gateway.fintivio.rosfin.tech    -> API gateway
#   auth.fintivio.rosfin.tech       -> Keycloak
#   files.fintivio.rosfin.tech      -> MinIO (only if file features are demoed)
DOMAIN=fintivio.rosfin.tech

# ─── Postgres ────────────────────────────────────────────────────────────────
# We RESTORE the full prod backup (scripts/04-restore-db.sh). The app database is
# `fintivio` with schema `main` (real-estate uses schema `real_estate`).
# POSTGRES_USER/PASSWORD here is the superuser the services connect AS — the restore
# runs as this user; the restored objects remain readable by it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres          # initial empty db; the restore creates the real ones
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_pg
# Node services (DATABASE_*) — point NAME at the restored app db:
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=fintivio
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME_pg
DATABASE_SCHEMA=main
# Java services read this (overrides the dev.fintivio.com hardcode in 3 *.yml):
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fintivio
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_pg
SPRING_DATASOURCE_HIKARI_SCHEMA=main

# ─── Java services: Azure Key Vault is DISABLED for the demo ──────────────────
# In prod the 6 Spring services pull secrets from Key Vault. Here we leave the
# endpoint BLANK (skips the Key Vault property source) and provide the secrets as
# plain env vars below. Spring relaxed binding maps DB_USER -> ${DB-USER}, etc.
AZURE_KEYVAULT_URL=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Secrets Key Vault used to supply (read by the Spring *.yml ${...} placeholders):
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_pg
EODHD_API_TOKEN_NEW=
# JASYPT_ENCRYPTION_KEY is in the integrations section below — it MUST equal the prod
# key if any restored/config value is ENC(...)-encrypted, else decryption fails.
# If a Java service refuses to boot with an empty Key Vault endpoint, uncomment:
# SPRING_CLOUD_AZURE_KEYVAULT_SECRET_PROPERTY_SOURCE_ENABLED=false

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis

# ─── MinIO (S3-compatible object storage) ────────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=CHANGE_ME_minio

# ─── Keycloak ────────────────────────────────────────────────────────────────
# With a prod restore, the `keycloak` database (realm, clients, users) comes from
# the backup; 04-restore-db.sh rewrites client redirect URIs/web origins to $DOMAIN.
# Set KEYCLOAK_REALM/CLIENT/SECRET/CLIENT_UUID below to the RESTORED prod values.
# Admin console creds (bootstrap admin; if the restored master realm has its own
# admin, use those to log in):
KC_ADMIN=admin
KC_ADMIN_PASSWORD=CHANGE_ME_kc
# Keycloak's own DB — must match the db name inside the backup (default: keycloak):
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=CHANGE_ME_pg
# What backend services use to reach / validate against Keycloak.
# NOTE: gateway builds JWKS as  http://${KEYCLOAK_HOST}/realms/${REALM}/...  so HOST must be host:port.
KEYCLOAK_HOST=keycloak:8080
KEYCLOAK_PORT=8080
KEYCLOAK_SSL=NONE
KEYCLOAK_REALM=fintivio
KEYCLOAK_CLIENT=fintivio-gateway
KEYCLOAK_CLIENT_UUID=CHANGE_ME_client_uuid
KEYCLOAK_SECRET=CHANGE_ME_client_secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_kc
# Public issuer the browser is redirected to for SSO (must be the public https URL):
KEYCLOAK_EXTERNAL_BASE_URL=https://auth.fintivio.rosfin.tech

# ─── Gateway middleware toggles ──────────────────────────────────────────────
AUTH_MIDDLEWERE=true
LOGGING_MIDDLEWERE=true
ERROR_MIDDLEWERE=true
SERVER_LOGGING_JSON=true
SERVER_TYPE_OF_STAND=prod
SERVER_SIZE_OF_BODY=200mb

# ─── Inter-service hosts (internal docker DNS) ───────────────────────────────
# These let the Configurator defaults point at the right place on this VM.
USER_MANAGEMENT_API_HOST=fintivio-user-management-api
USER_MANAGEMENT_API_PORT=8080
USER_MANAGEMENT_HOST=fintivio-user-management-api
USER_MANAGEMENT_PORT=8080
ENTITY_MANAGEMENT_HOST=fintivio-entity-management-api
ENTITY_MANAGEMENT_PORT=8080
FAMILY_MANAGER_HOST=fintivio-family-management-api
FAMILY_MANAGER_PORT=8080
ASSET_MANAGEMENT_API_HOST=fintivio-asset-management-api
ASSET_MANAGEMENT_API_PORT=8080
# document-api acts as the "file manager"; only needed if file features are demoed:
FILE_MANAGER_HOST=fintivio-document-api
FILE_MANAGER_PORT=8080
FILE_MANAGER_EXTERNAL=https://gateway.fintivio.rosfin.tech/fintivio-document-api.application
# Java-style *_BASE_URL defaults (real-estate, reports, brokerage):
ACCOUNTS_API_BASE_URL=http://fintivio-accounts-api:8080
DOCUMENTS_API_BASE_URL=http://fintivio-document-api:8080
NOTIFICATIONS_API_BASE_URL=http://fintivio-notifications-api:8080
ASSET_MANAGEMENT_API_BASE_URL=http://fintivio-asset-management-api:8080
NOTIFICATION_SERVICE_URL=http://fintivio-notifications-api:8080

# ─── Email / SMTP (OPTIONAL — invitation & password-reset mails) ─────────────
# Leave blank to skip outbound email. Gmail app passwords if used.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_RESTORE_MAIL=
EMAIL_RESTORE_PASSWORD=
EMAIL_NO_REPLY_MAIL=
EMAIL_NO_REPLY_PASSWORD=

# ─── External market-data / integrations ─────────────────────────────────────
# EODHD drives most dashboard/asset/markets numbers — set it for meaningful demo data.
EODHD_API_KEY=
EODHD_API_TOKEN=demo
# Brokerage integrations (OPTIONAL — leave blank/disabled for the demo):
SNAPSHOT_SCHEDULER_ENABLED=false
LEASE_SCHEDULER_ENABLED=false
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CLIENT_SECRET=
PLAID_CLIENT_ID=
PLAID_CLIENT_SECRET=
PLAID_ENVIRONMENT=sandbox
WEALTHREADER_API_KEY=
JASYPT_ENCRYPTION_KEY=CHANGE_ME_jasypt

# ─── Image coordinates ───────────────────────────────────────────────────────
# Backend images are pulled from Docker Hub as-is; frontends are built locally
# by scripts/03-build-frontends.sh and tagged <repo>:demo.
BACKEND_IMAGE_NAMESPACE=admacc1
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=demo

# ─── AI document extraction (Phase 1.5) ──────────────────────────────────────
# Orchestrator + ollama env is set in docker-compose.yml (INFERENCE_URL/MODEL,
# EXTRACT_*). One-time setup after `up`:
#   docker exec fintivio-ollama ollama pull qwen2.5:3b-instruct
#   docker exec -i fintivio-postgres psql -U <superuser> -d fintivio -f - < db/ai/ai-demo-setup.sql
#   docker compose restart fintivio-gateway   # reload role->URI permissions
# document-api presigned-URL host (MinIO public vhost):
MINIO_EXTERNAL_HOST=files.fintivio.rosfin.tech

# ─── Fixes discovered during first VM bring-up (REQUIRED) ─────────────────────
SERVER_PORT=8080                       # standardize listen port (lifestyle-assets defaults to 4000)
SERVER_TIMEOUT_EXTERNAL_CALLS=300000   # gateway->backend axios timeout MS; must exceed AI extract latency (CPU inference = minutes). Was 15000 pre-AI.
AZURE_KEYVAULT_URL=https://disabled.vault.azure.net/  # dummy non-empty: Node boot-hydration throws on empty, then skips all (keys preset). Java anchor overrides to "".
MINIO_USER=minioadmin                  # some services map MINIO_USER (others MINIO_USERNAME) — set both
EMAIL_SERVICE_ADDRESS=                 # notifications-api (optional/disabled)
EMAIL_SERVICE_APP_PASSWORD=
RABBITMQ_URL=
